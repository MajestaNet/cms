---
/**
 * Always reserve the right column on doc pages (header + left nav stay put).
 * Starlight only mounts this aside when a page has a TOC, so navigating
 * between overlay-only pages and included-source pages reflows the whole
 * main pane. Keep the column; leave it empty for later screenshots/videos.
 */
const { hasSidebar, entry } = Astro.locals.starlightRoute;
const reserveAside = hasSidebar && entry.data.template !== 'splash';
type Figure = { src: string; alt: string; caption: string };
const figures: Figure[] = Array.isArray(entry.data.cmsFigures)
	? (entry.data.cmsFigures as Figure[])
	: [];
---

<div class="lg:sl-flex">
	{
		reserveAside && (
			<aside class="right-sidebar-container print:hidden" aria-label="Page media">
				<div class="right-sidebar">
					{
						figures.map((figure) => (
							<figure class="cms-figure">
								<img src={figure.src} alt={figure.alt} />
								<figcaption>{figure.caption}</figcaption>
							</figure>
						))
					}
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	<div class="main-pane"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.main-pane {
			isolation: isolate;
		}

		.right-sidebar-container {
			display: none;
		}

		@media (min-width: 72rem) {
			.right-sidebar-container {
				display: block;
				order: 2;
				position: relative;
				width: max(
					var(--sl-sidebar-width),
					calc(
						var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
					)
				);
			}

			.right-sidebar {
				position: fixed;
				top: 0;
				border-inline-start: 1px solid var(--sl-color-hairline);
				padding-top: var(--sl-nav-height);
				width: 100%;
				height: 100vh;
				overflow-y: auto;
				scrollbar-width: none;
			}

			.cms-figure {
				margin: 0;
				padding: 1rem 1rem 0;
			}

			.cms-figure img {
				display: block;
				width: 100%;
				height: auto;
				border: 1px solid var(--sl-color-hairline);
				border-radius: 0;
			}

			.cms-figure figcaption {
				margin-top: 0.4rem;
				font-family: var(--font-display), 'Josefin Sans', sans-serif;
				font-size: 0.85rem;
				color: var(--sl-color-gray-3);
			}

			.main-pane {
				width: 100%;
			}

			:global([data-has-sidebar]) .main-pane {
				--sl-content-margin-inline: auto 0;

				order: 1;
				width: min(
					calc(100% - var(--sl-sidebar-width)),
					calc(
						var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
					)
				);
			}
		}
	}
</style>

---
import Pagination from '@astrojs/starlight/components/Pagination.astro';

/**
 * Customer footer. “Edit this page” would point at overlay files in this
 * aggregator — operators want the product source instead.
 * Replace SOURCE_REPO (example: MajestaNet/two).
 */
---

<footer class="mn-footer sl-flex">
	<p class="mn-footer-source">
		<a href="https://github.com/SOURCE_REPO">Source & contributing</a> on GitHub.
		Agent playbooks and the backlog stay there — they are not part of this host.
	</p>
	<Pagination />
</footer>
